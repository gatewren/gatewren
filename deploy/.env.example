# --- Obligatoire ---------------------------------------------------------------------
# Nom de domaine du portail (enregistrement DNS A/AAAA vers ce serveur).
DOMAIN=vpn.exemple.fr
# Adresse à laquelle les clients WireGuard joignent ce serveur.
WG_ENDPOINT=vpn.exemple.fr:51820
# Mot de passe du compte « admin » créé au premier démarrage (sinon affiché dans les logs).
ADMIN_PASSWORD=

# --- Version de l'image ------------------------------------------------------------------
GATEWREN_IMAGE=ghcr.io/gatewren/gatewren
GATEWREN_VERSION=latest

# --- Réseau VPN ----------------------------------------------------------------------
WG_PORT=51820
WG_SUBNET=10.8.0.0/24
WG_DNS=

# --- Accès (modifiable ensuite dans Réglages) ------------------------------------------------
VPN_REQUIRE_LOGIN=true
VPN_REQUIRE_MFA=true
VPN_SESSION_HOURS=12
# Langue par défaut de l'interface et des e-mails (fr, en) ; chacun peut choisir la sienne.
DEFAULT_LOCALE=fr

# --- E-mails (facultatif, modifiable dans Réglages > E-mails) -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Gatewren

# Ports publics de Caddy (à changer seulement s'ils sont déjà pris ; Let's Encrypt exige 80 et 443).
HTTP_PUBLISH=80
HTTPS_PUBLISH=443

LOG_LEVEL=INFO
