# Portail Keystile en HTTPS (certificat Let's Encrypt obtenu et renouvelé automatiquement).
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy keystile:8080 {
		# Flux temps réel (Server-Sent Events) : pas de mise en tampon.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
